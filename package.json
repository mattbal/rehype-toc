{
  "name": "@mattbal/rehype-toc",
  "version": "3.5.0",
  "description": "A rehype plugin that adds a table of contents (TOC) to the page",
  "keywords": [
    "unified",
    "rehype",
    "plugin",
    "rehype-plugin",
    "table-of-contents",
    "toc",
    "html"
  ],
  "author": {
    "name": "Matt Balint"
  },
  "license": "MIT",
  "homepage": "https://github.com/mattbal/rehype-toc",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattbal/rehype-toc.git"
  },
  "type": "module",
  "exports": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "shx rm -rf coverage lib",
    "lint": "eslint src test",
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "mocha && npm run lint",
    "coverage": "c8 mocha",
    "release": "npm run clean && npm run build && npm test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/chai": "^5.2.0",
    "@types/hast": "^3.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "@types/unist": "^3.0.3",
    "c8": "^10.1.3",
    "chai": "^5.2.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-jsdoc": "^50.6.6",
    "eslint-plugin-n": "^17.16.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "mocha": "^11.1.0",
    "prettier": "3.5.3",
    "rehype-parse": "^9.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "shx": "^0.3.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "unified": "^11.0.5"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,yml,ts,css,html,md}": "prettier --write"
  }
}
